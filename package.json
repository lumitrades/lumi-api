{
  "name": "lumi-api",
  "version": "1.1.3",
  "description": "Pay-per-call x402 seller checks (Lumi Trust), crypto market data and Lumi Market Ideas (paper-trade analysis, not investment advice) from Lumi Trades for AI agents, paid via x402 on the XRP Ledger (XRP, RLUSD, USDC) or with USDC on Base. A2A agent card + remote MCP.",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/node.ts",
    "dev": "wrangler dev --env testnet",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "testnet:setup": "tsx scripts/testnet-setup.ts",
    "demo:testnet": "tsx scripts/demo-testnet.ts",
    "deploy:testnet": "wrangler deploy --env testnet",
    "deploy": "wrangler deploy",
    "build:check": "wrangler deploy --dry-run --outdir .wrangler/dist",
    "probe:replay": "tsx scripts/replay-probe.ts",
    "client": "tsx examples/agent-client.ts",
    "demo:testnet:stablecoin": "tsx scripts/demo-testnet-stablecoin.ts",
    "demo:buyer:create": "tsx scripts/demo-buyer-create.ts",
    "demo:mainnet": "tsx scripts/demo-mainnet.ts",
    "test:mcp": "npm --prefix mcp test"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@x402/core": "^2.28.0",
    "ripple-keypairs": "^2.1.0",
    "x402-xrpl": "^0.3.4",
    "xrpl": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@x402/evm": "^2.28.0",
    "@x402/extensions": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "viem": "^2.57.10",
    "vitest": "^5.0.5",
    "wrangler": "^4.86.0"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
