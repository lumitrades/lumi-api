# Copy to .dev.vars for `wrangler dev --env testnet` / `npm start`. Never commit .dev.vars.
XRPL_NETWORK=xrpl:1
PAY_TO=rYourTestnetReceiverAddress
FACILITATOR_URL=https://xrpl-facilitator-testnet.t54.ai
INVOICE_SECRET=change-me-to-a-long-random-string
# Optional: comma-separated private names to scrub from paid responses
PRIVATE_NAMES=
# Optional: USDC on Base Sepolia via x402 (address only)
EVM_NETWORK=eip155:84532
EVM_PAY_TO=0xYourBaseSepoliaReceiverAddress
EVM_FACILITATOR_URL=https://x402.org/facilitator
# Customer wallet HMAC (>= 32 chars). Required for new feed-key binds. Never commit the real value.
PAYER_HMAC_SECRET=
# Optional previous secret during a rotation. Keep it set as long as any purged row still carries an old HMAC.
# PAYER_HMAC_SECRET_PREV=
# PAYER_RETENTION_DAYS=90
# PAYER_PURGE is a wrangler.toml var, committed "off". Do not turn it on in this file.
